NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side Cloudinary settings (for unsigned uploads from browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server-only Cloudinary credentials (for authenticated asset deletion). Never prefix with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-side only — used by /api/generate-caption for AI photography captions. Never expose to frontend.
GEMINI_API_KEY=
# Designated single-owner administrator email
ADMIN_EMAIL=aryan.pol737@gmail.com

# Canonical public URL used for auth email links. No trailing slash.
NEXT_PUBLIC_APP_URL=https://frame-aryan-on-cam.vercel.app
